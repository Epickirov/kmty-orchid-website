# Files in the repo root that are NOT part of the served website, so Cloudflare
# Workers does not try to upload them as static assets. Uses .gitignore syntax.
.git
worker.js
wrangler.jsonc
wrangler.toml
netlify.toml
README.md
build_fonts.py
*.py
.gitignore
.assetsignore
# the exhibition kiosk runs off a laptop at the booth (kiosk/server.js), not off
# the website. Its shared pieces — plant.js and plants/ — live at the root and
# ARE served, because the order page's 整株 tab uses them too.
kiosk
